<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_document_expiry" model="ir.module.category">
        <field name="name">Document Expiry Tracking</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_document_expiry_user" model="res.groups">
        <field name="name">Document User</field>
        <field name="category_id" ref="module_category_document_expiry"/>
        <field name="comment">Can view documents and upload/edit documents they are responsible for.</field>
    </record>

    <record id="group_document_expiry_manager" model="res.groups">
        <field name="name">Document Manager</field>
        <field name="category_id" ref="module_category_document_expiry"/>
        <field name="implied_ids" eval="[(4, ref('group_document_expiry_user'))]"/>
        <field name="comment">Can create/edit/delete any document, configure document types, thresholds and reminders, and view the dashboard.</field>
    </record>

    <record id="group_document_expiry_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_document_expiry"/>
        <field name="implied_ids" eval="[(4, ref('group_document_expiry_manager'))]"/>
        <field name="comment">Full access, including security configuration.</field>
    </record>

    <!-- Record rule: Document Users only see/edit documents they uploaded or are responsible for -->
    <record id="rule_document_user_own" model="ir.rule">
        <field name="name">Document User: own or responsible documents only</field>
        <field name="model_id" ref="model_document_expiry_document"/>
        <field name="domain_force">['|', ('uploaded_by', '=', user.id), ('responsible_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_document_expiry_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Managers and Admins: unrestricted -->
    <record id="rule_document_manager_all" model="ir.rule">
        <field name="name">Document Manager: all documents</field>
        <field name="model_id" ref="model_document_expiry_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_document_expiry_manager'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>
</odoo>
