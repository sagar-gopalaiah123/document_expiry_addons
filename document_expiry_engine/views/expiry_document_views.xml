<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_expiry_document_list" model="ir.ui.view">
        <field name="name">document.expiry.document.list</field>
        <field name="model">document.expiry.document</field>
        <field name="arch" type="xml">
            <list string="Documents" decoration-danger="status == 'expired'"
                  decoration-warning="status == 'expiring_soon'"
                  decoration-success="status == 'valid'"
                  decoration-muted="status == 'no_expiry'">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="document_number"/>
                <field name="resource_ref"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_remaining"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'expired'"
                       decoration-warning="status == 'expiring_soon'"
                       decoration-success="status == 'valid'"
                       decoration-muted="status == 'no_expiry'"/>
                <field name="responsible_user_id"/>
                <field name="uploaded_by"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_document_expiry_document_kanban" model="ir.ui.view">
        <field name="name">document.expiry.document.kanban</field>
        <field name="model">document.expiry.document</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                            </div>
                            <div>
                                <field name="document_type_id"/>
                            </div>
                            <div>
                                Expiry: <field name="expiry_date"/>
                            </div>
                            <div>
                                <field name="status" widget="badge"
                                       decoration-danger="status == 'expired'"
                                       decoration-warning="status == 'expiring_soon'"
                                       decoration-success="status == 'valid'"
                                       decoration-muted="status == 'no_expiry'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_document_expiry_document_form" model="ir.ui.view">
        <field name="name">document.expiry.document.form</field>
        <field name="model">document.expiry.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="history_count == 0">
                            <field name="history_count" widget="statinfo" string="Versions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="status != 'expired'"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-warning"
                            invisible="status != 'expiring_soon'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Document name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type_id"/>
                            <field name="document_number"/>
                            <field name="res_model_id" string="Related Model"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" string="Related Record ID"
                                   invisible="not res_model_id"/>
                            <field name="resource_ref" invisible="not resource_ref"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="has_expiry"/>
                            <field name="expiry_date" invisible="not has_expiry"/>
                            <field name="status" widget="badge"
                                   decoration-danger="status == 'expired'"
                                   decoration-warning="status == 'expiring_soon'"
                                   decoration-success="status == 'valid'"
                                   decoration-muted="status == 'no_expiry'"/>
                            <field name="days_remaining" invisible="not has_expiry"/>
                            <field name="responsible_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachment" name="attachment">
                            <group>
                                <field name="attachment_datas" filename="attachment_name"
                                       widget="binary"/>
                                <field name="attachment_name" invisible="1"/>
                                <field name="attachment_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Remarks" name="remarks">
                            <field name="remarks" placeholder="Notes..."/>
                        </page>
                        <page string="Audit" name="audit">
                            <group>
                                <field name="uploaded_by"/>
                                <field name="upload_date"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_document_expiry_document_search" model="ir.ui.view">
        <field name="name">document.expiry.document.search</field>
        <field name="model">document.expiry.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name"/>
                <field name="document_number"/>
                <field name="document_type_id"/>
                <field name="responsible_user_id"/>
                <field name="res_model_id"/>
                <separator/>
                <filter string="Expired" name="filter_expired" domain="[('status','=','expired')]"/>
                <filter string="Expiring Today" name="filter_today"
                        domain="[('status','!=','no_expiry'),('days_remaining','=',0)]"/>
                <filter string="Expiring This Week" name="filter_week"
                        domain="[('status','!=','no_expiry'),('days_remaining','&gt;=',0),('days_remaining','&lt;=',7)]"/>
                <filter string="Expiring This Month" name="filter_month"
                        domain="[('status','!=','no_expiry'),('days_remaining','&gt;=',0),('days_remaining','&lt;=',30)]"/>
                <filter string="Expiring Soon" name="filter_expiring_soon" domain="[('status','=','expiring_soon')]"/>
                <filter string="Valid" name="filter_valid" domain="[('status','=','valid')]"/>
                <filter string="No Expiry" name="filter_no_expiry" domain="[('status','=','no_expiry')]"/>
                <separator/>
                <filter string="Issue Date" name="filter_issue_date" date="issue_date"/>
                <filter string="Expiry Date" name="filter_expiry_date" date="expiry_date"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Document Type" name="group_type" context="{'group_by':'document_type_id'}"/>
                    <filter string="Responsible User" name="group_responsible" context="{'group_by':'responsible_user_id'}"/>
                    <filter string="Related Model" name="group_model" context="{'group_by':'res_model_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="Expiry Date" name="group_expiry_date" context="{'group_by':'expiry_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_document_expiry_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">document.expiry.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_expiring_soon': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">Upload your first document</p>
            <p>Track documents with an expiry date across employees, customers, vendors,
               vehicles, contracts or any other business record.</p>
        </field>
    </record>
</odoo>