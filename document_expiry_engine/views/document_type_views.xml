<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_expiry_type_list" model="ir.ui.view">
        <field name="name">document.expiry.type.list</field>
        <field name="model">document.expiry.type</field>
        <field name="arch" type="xml">
            <list string="Document Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_expiry_applicable"/>
                <field name="default_validity_days"/>
                <field name="responsible_user_id"/>
                <field name="document_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_document_expiry_type_form" model="ir.ui.view">
        <field name="name">document.expiry.type.form</field>
        <field name="model">document.expiry.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Passport, License, Insurance..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_expiry_applicable"/>
                            <field name="default_validity_days"
                                   invisible="not is_expiry_applicable"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="responsible_user_id"/>
                            <field name="responsible_group_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                    <notebook invisible="not is_expiry_applicable">
                        <page string="Reminder Rules" name="reminders">
                            <field name="reminder_rule_ids">
                                <list editable="bottom">
                                    <field name="days_before"/>
                                    <field name="notify_activity"/>
                                    <field name="notify_email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_document_expiry_type_search" model="ir.ui.view">
        <field name="name">document.expiry.type.search</field>
        <field name="model">document.expiry.type</field>
        <field name="arch" type="xml">
            <search string="Document Types">
                <field name="name"/>
                <filter string="Has Expiry" name="has_expiry" domain="[('is_expiry_applicable','=',True)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_document_expiry_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">document.expiry.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">Create a document type</p>
            <p>Define document categories (Passport, License, Insurance, Contract...) with a
               default validity period and reminder rules.</p>
        </field>
    </record>
</odoo>
