<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_document" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.url</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='res_config_dev_tool']" position="before">

                <div class="app_settings_block" data-string="Document Expiry" string="Document Expiry"
                     data-key="document_expiry_engine" groups="document_expiry_engine.group_document_expiry_manager">
                    <h2>Document Expiry Tracking</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="expiring_soon_days" string="Expiring Soon Threshold"/>
                                <div class="text-muted">
                                    Number of days before expiry at which a document is flagged "Expiring Soon"
                                </div>
                                <div class="content-group">
                                    <field name="expiring_soon_days"/> days
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="action_document_expiry_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'document_expiry_engine'}</field>
    </record>
</odoo>